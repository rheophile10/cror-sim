{
  "name": "world-sim-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "One-page isometric viewer for world-sim scenes.",
  "scripts": {
    "lib": "npm --prefix ../world-sim run build",
    "check": "npm run lib && tsc --noEmit -p tsconfig.json",
    "dev": "npm run lib && vite",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.0",
    "world-sim": "file:../world-sim"
  }
}
