# Link the world-sim dependency instead of copying it.
#
# npm's default for a `file:` dependency here is to pack the target and unpack a
# snapshot into node_modules, which silently freezes the library at whatever it
# was when `npm install` last ran — the app keeps building green against stale
# code. A symlink means `npm run lib` is enough to pick up a change.
install-links=false
